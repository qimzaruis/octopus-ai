# ===== โหมดการทํางาน =====
# ตั้ง env ของ Supabase + DATABASE_URL ครบ = ใช้ของจริงเสมอ (แม้ APP_ENV=development)
# ยังไม่ตั้ง = รันด้วยข้อมูลตัวอย่าง (Demo) เพื่อให้เปิดหน้าเว็บดูได้ทันที
APP_ENV=development
# บังคับทับโหมด: 1 = Demo, 0 = ของจริง (เว้นว่าง = ดูจาก env ว่าตั้งครบหรือยัง)
DEMO_MODE=

# บน host จริงให้ตั้งเป็น APP_ENV=production + DEMO_MODE=0
# และที่ Supabase > Authentication > URL Configuration ต้องตั้ง Site URL เป็นโดเมนจริง
# พร้อมใส่โดเมนนั้นใน Additional Redirect URLs ด้วย (เช่น https://octopus-ai.flashhub.net/**)
# ไม่อย่างนั้น login ด้วย Google เสร็จแล้วจะถูกดีดกลับไปที่ Site URL เดิม (เช่น localhost)
# ดู checklist เต็มที่หัวข้อ "Deploy ขึ้น Production" ใน README

# URL ของเว็บนี้ (ไม่มี slash ท้าย) — ใช้ใน system prompt ของเอเจนต์,
# ตัวอย่างโค้ดเรียก API บนหน้า landing และ metadata ของหน้าเว็บ
NEXT_PUBLIC_APP_URL=https://octopus-ai.flashhub.net

# ===== Supabase Auth (จําเป็นสําหรับเข้าสู่ระบบด้วย Google) =====
# ดึงค่าจาก Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# ===== Database (Supabase Postgres สำหรับ Drizzle ORM) =====
# ดึงค่าจาก Supabase Dashboard > Project Settings > Database > Connection string (URI)
# ใช้ connection แบบ pooler (port 6543) แนะนำสำหรับ serverless
DATABASE_URL=postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Service role key (ใช้ seed ข้อมูล / admin task — อย่า expose ทาง client)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ===== ถ้าไม่ใส่ NEXT_PUBLIC_SUPABASE_URL ระบบจะรันในโหมด Demo =====
# (ดูข้อมูลตัวอย่างได้ทันที โดยเข้าสู่ระบบด้วยปุ่ม Demo Login)

# ===== Web Agent =====
# โควตาโต้นเอาต์พุตต่อหนึ่งคำตอบ ถ้าตั้งน้อยเกิน โค้ดยาว ๆ จะถูกตัดกลางทาง
# และ tool_call arguments จะเป็น JSON ไม่สมบูรณ์ (เว้นว่าง = ใช้ 8000)
AGENT_MAX_TOKENS=32000

# ค้นหาเว็บให้เอเจนต์ (Google ผ่าน Bright Data SERP API) — โควตาของบัญชีรีเซ็ตรายเดือน
# คีย์นี้ใช้บนเซิร์ฟเวอร์เท่านั้น ไม่เคยถูกส่งลงเบราว์เซอร์ของผู้ใช้
BRIGHTDATA_API_KEY=
# ชื่อ zone ประเภท SERP API ในบัญชี Bright Data
BRIGHTDATA_SERP_ZONE=serp_api1
