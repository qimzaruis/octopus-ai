# ===== Supabase Auth (จำเป็นสำหรับเข้าสู่ระบบด้วย Google) =====
# ดึงค่าจาก Supabase Dashboard > Project Settings > API
# ===== โหมดการทํางาน =====
# development = ใช้ Demo ได้ทันที (ไม่ต้อง login Google) | production = บังคับของจริง
APP_ENV=development
# บังคับทับโหมด: 1 = Demo, 0 = ของจริง (เว้นว่าง = ใช้ค่าเริ่มต้นของ APP_ENV)
# ตัวอย่าง: ทดสอบ Google login + DB ในเครื่อง ให้ตั้ง DEMO_MODE=0
DEMO_MODE=

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# ===== Database (Supabase Postgres สำหรับ Drizzle ORM) =====
# ดึงค่าจาก Supabase Dashboard > Project Settings > Database > Connection string (URI)
# ใช้ connection แบบ pooler (port 6543) แนะนำสำหรับ serverless
DATABASE_URL=postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Service role key (ใช้ seed ข้อมูล / admin task — อย่า expose ทาง client)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ===== ถ้าไม่ใส่ NEXT_PUBLIC_SUPABASE_URL ระบบจะรันในโหมด Demo =====
# (ดูข้อมูลตัวอย่างได้ทันที โดยเข้าสู่ระบบด้วยปุ่ม Demo Login)
